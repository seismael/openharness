{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-tools.org/schemas/oalp/v1/journal.schema.json",
  "title": "OpenAgent Loop Protocol - Journal Entry Schema",
  "description": "Schema for each line in the append-only journal.jsonl ledger.",
  "type": "object",
  "required": [
    "ts",
    "iteration",
    "front",
    "hypothesis",
    "decision"
  ],
  "properties": {
    "ts": {
      "type": "string",
      "description": "ISO 8601 timestamp of the iteration entry."
    },
    "iteration": {
      "type": "integer",
      "minimum": 0
    },
    "front": {
      "type": "string",
      "enum": [
        "orient",
        "discover",
        "audit",
        "diagnose",
        "research",
        "debug",
        "improve",
        "harden",
        "performance",
        "pipeline",
        "knowledge",
        "plan"
      ]
    },
    "hypothesis": {
      "type": "string",
      "description": "The specific falsifiable hypothesis tested in this iteration."
    },
    "candidate_commit": {
      "type": "string",
      "description": "Pre-evaluation git snapshot commit hash."
    },
    "metric_before": {
      "type": ["number", "null"]
    },
    "metric_after": {
      "type": ["number", "null"]
    },
    "decision": {
      "type": "string",
      "enum": ["adopted", "rejected", "inconclusive", "informational"]
    },
    "decision_ref": {
      "type": "string",
      "description": "Reference identifier to the immutable record in decisions/ (e.g., 'D-190')."
    },
    "invariant_checks": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "rationale": {
      "type": "string",
      "description": "Empirical explanation for the adoption, rejection, or findings."
    }
  },
  "additionalProperties": true
}
